generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChapterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PAID
  APPROVED
  REJECTED
}

enum PaymentOutcome {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  COACH
  ORGANIZER
}

enum EventType {
  KYORUGI
  POOMSAE
  FREESTYLE_POOMSAE
  BREAKING
}

enum BeltType {
  WHITE
  YELLOW
  GREEN
  BLUE
  RED
  BLACK
}

model Event {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  location             String
  imageUrl             String?
  eventDate            DateTime
  registrationDeadline DateTime
  entryFeePesos        Int                @default(500)
  status               EventStatus        @default(DRAFT)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  orders               Order[]
  approvedAthletes     ApprovedAthlete[]
  divisions            Division[]

  @@index([status])
  @@index([eventDate])
}

model Athlete {
  id          String          @id @default(cuid())
  chapterId   String
  name        String
  gender      Gender
  birthYear   Int
  weightKg    Int             @default(0)
  beltType    BeltType?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  chapter     Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  approvedAthletes ApprovedAthlete[]
  bracketCells BracketCell[]

  @@index([chapterId])
  @@index([chapterId, gender])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Athlete_name_trgm_idx")
}

model WeightClass {
  id        String     @id @default(cuid())
  gender    Gender
  name      String
  minKg     Float?
  maxKg     Float?
  sortOrder Int
  divisions Division[]

  @@unique([gender, name])
  @@index([gender, sortOrder])
}

model Order {
  id          String             @id @default(cuid())
  coachId     String
  eventId     String
  chapterId   String
  status      OrderStatus        @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  coach       Chapter            @relation("CoachOrders", fields: [coachId], references: [id], onDelete: Cascade)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  chapter     Chapter            @relation("ChapterOrders", fields: [chapterId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  payments    PaymentAttempt[]
  approvedAthletes ApprovedAthlete[]

  @@index([eventId, chapterId])
  @@index([status])
  @@index([coachId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  athleteId   String

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([orderId, athleteId])
  @@index([orderId])
  @@index([athleteId])
}

model ApprovedAthlete {
  id          String   @id @default(cuid())
  eventId     String
  chapterId   String
  athleteId   String
  orderId     String
  approvedAt  DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@index([chapterId])
  @@index([eventId])
}

model PaymentAttempt {
  id              String         @id @default(cuid())
  orderId         String
  referenceNo     String
  proofUrl        String
  amountPesos     Int
  outcome         PaymentOutcome @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([outcome])
}

model Division {
  id            String      @id @default(cuid())
  eventId       String
  name          String
  gender        Gender
  eventType     EventType
  divisionKey   String
  minAge        Int?
  maxAge        Int?
  weightClassId String?
  beltType      BeltType?
  createdAt     DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id], onDelete: SetNull)
  brackets      BracketCell[]

  @@unique([eventId, divisionKey])
  @@index([eventType])
}

model BracketCell {
  id              String   @id @default(cuid())
  divisionId      String
  round           Int
  position        Int
  athleteId       String?
  childAId        String?
  childBId        String?
  winnerAthleteId String?
  division        Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  athlete         Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@index([divisionId, round, position])
}

model Chapter {
  id              String             @id @default(cuid())
  name            String
  province        String
  city            String
  gcashNumber     String
  logoUrl         String?
  headCoachName   String
  headCoachEmail  String
  status          ChapterStatus      @default(PENDING)
  rejectionReason String?
  headCoachUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  athletes        Athlete[]
  coachOrders     Order[]            @relation("CoachOrders")
  chapterOrders   Order[]            @relation("ChapterOrders")
  approvedAthletes ApprovedAthlete[]
  notifications   Notification[]

  @@index([status])
  @@index([province])
}

model Notification {
  id              String   @id @default(cuid())
  role            Role
  targetChapterId String?
  title           String
  body            String?
  link            String?
  readAt          DateTime?
  createdAt       DateTime @default(now())
  chapter         Chapter? @relation(fields: [targetChapterId], references: [id], onDelete: Cascade)

  @@index([role, readAt])
  @@index([role, targetChapterId, readAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  role      Role?
  userId    String?
  chapterId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}
