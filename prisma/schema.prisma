generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChapterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  COACH
  ORGANIZER
}

enum EventType {
  KYORUGI
  POOMSAE
  FREESTYLE_POOMSAE
  BREAKING
}

enum BeltType {
  WHITE
  YELLOW
  GREEN
  BLUE
  RED
  BLACK
}

model Event {
  id                   String      @id @default(cuid())
  name                 String
  description          String?
  location             String
  imageUrl             String?
  eventDate            DateTime
  registrationDeadline DateTime
  entryFeePesos        Int          @default(500)
  status               EventStatus  @default(DRAFT)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  enrollments          Enrollment[]
  payments             TeamPayment[]
  divisions            Division[]

  @@index([status])
  @@index([eventDate])
}

model Athlete {
  id          String       @id @default(cuid())
  chapterId   String
  name        String
  gender      Gender
  birthYear   Int
  weightKg    Int          @default(0)
  beltType    BeltType?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  bracketCells BracketCell[]

  @@index([chapterId])
  @@index([chapterId, gender])
  // Accelerates the admin athletes list `name { contains, mode: insensitive }`
  // filter (ILIKE '%q%'), which a plain btree index cannot serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Athlete_name_trgm_idx")
}

model WeightClass {
  id        String     @id @default(cuid())
  gender    Gender
  name      String
  minKg     Float?
  maxKg     Float?
  sortOrder Int
  divisions Division[]

  @@unique([gender, name])
  @@index([gender, sortOrder])
}

model Enrollment {
  id        String   @id @default(cuid())
  eventId   String
  athleteId String
  chapterId String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@index([eventId])
  @@index([chapterId])
  @@index([athleteId])
}

model TeamPayment {
  id              String        @id @default(cuid())
  eventId         String
  chapterId       String
  amountPesos     Int
  referenceNo     String
  proofUrl        String
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  chapter         Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([eventId, chapterId])
  @@index([status])
}

model Division {
  id            String      @id @default(cuid())
  eventId       String
  name          String
  gender        Gender
  eventType     EventType
  divisionKey   String
  minAge        Int?
  maxAge        Int?
  weightClassId String?
  beltType      BeltType?
  createdAt     DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id], onDelete: SetNull)
  brackets      BracketCell[]

  @@unique([eventId, divisionKey])
  @@index([eventType])
}

model BracketCell {
  id              String   @id @default(cuid())
  divisionId      String
  round           Int
  position        Int
  athleteId       String?
  childAId        String?
  childBId        String?
  winnerAthleteId String?
  division        Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  athlete         Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@index([divisionId, round, position])
}

model Chapter {
  id              String        @id @default(cuid())
  name            String
  province        String
  city            String
  gcashNumber     String
  logoUrl         String?
  headCoachName   String
  // No @unique here: uniqueness for active rows is enforced by a partial
  // unique index on (headCoachEmail) WHERE status IN ('PENDING','APPROVED'),
  // created in migration 20260813173221_add_chapter. It allows a REJECTED
  // chapter to free the email for re-registration. Prisma cannot express
  // partial indexes in the schema.
  headCoachEmail  String
  status          ChapterStatus @default(PENDING)
  rejectionReason String?
  headCoachUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  athletes        Athlete[]
  enrollments     Enrollment[]
  payments        TeamPayment[]
  notifications   Notification[]

  @@index([status])
  @@index([province])
}

model Notification {
  id              String   @id @default(cuid())
  role            Role
  targetChapterId String?
  title           String
  body            String?
  link            String?
  readAt          DateTime?
  createdAt       DateTime @default(now())
  chapter         Chapter? @relation(fields: [targetChapterId], references: [id], onDelete: Cascade)

  @@index([role, readAt])
  @@index([role, targetChapterId, readAt])
}
